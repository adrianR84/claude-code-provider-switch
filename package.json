{
  "name": "@adrianr84/claude-code-provider-switch",
  "version": "1.0.0",
  "description": "Cross-platform Claude Code provider switcher (OpenRouter, Ollama, Minimax, Anthropic)",
  "main": "index.js",
  "bin": {
    "claude-switch": "./bin/claude-switch.js",
    "cs": "./bin/claude-switch.js"
  },
  "scripts": {
    "start": "node bin/claude-switch.js",
    "dev": "node bin/claude-switch.js",
    "link": "npm link",
    "unlink": "npm unlink -g @adrianr84/claude-code-provider-switch",
    "pub": "npm version patch && npm publish --access public && git push origin main --tags",
    "pub-minor": "npm version minor && npm publish --access public && git push origin main --tags",
    "pub-major": "npm version major && npm publish --access public && git push origin main --tags",
    "deploy": "npm publish --access public && echo '✅ Deployed to npm!'",
    "test:validation": "node test/test-validation-errors.js",
    "test:provider": "node test/test-provider-integration.js",
    "test:comprehensive": "node test/test-comprehensive.js",
    "test:all": "node test/run-tests.js"
  },
  "keywords": [
    "claude-code",
    "claude code provider switcher",
    "claude code model switcher",
    "claude code llm switcher",
    "claude code llm provider switcher",
    "ai provider switcher",
    "claude code ai model switcher",
    "claude code ai model provider switcher",
    "claude code OpenRouter",
    "claude code Ollama",
    "cli"
  ],
  "author": "Adrian R",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianR84/claude-code-provider-switch.git"
  },
  "homepage": "https://github.com/adrianR84/claude-code-provider-switch#readme",
  "bugs": {
    "url": "https://github.com/adrianR84/claude-code-provider-switch/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "index.js"
  ],
  "preferGlobal": true
}
